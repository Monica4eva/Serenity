{
  "expo": {
    "name": "Project Serenity",
    "slug": "project-serenity",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "bw.serenity.app",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Use Face ID to unlock Project Serenity.",
        "NSLocationWhenInUseUsageDescription": "Only used if you choose to send your location to an emergency contact.",
        "NSMicrophoneUsageDescription": "Only used when you choose to record a voice note for your journal."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "bw.serenity.app",
      "permissions": [
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "allowBackup": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single",
      "name": "Project Serenity",
      "shortName": "Serenity",
      "description": "Daily support, healthy habits and lasting well-being on your recovery journey.",
      "lang": "en",
      "themeColor": "#4E649D",
      "backgroundColor": "#FFFFFF",
      "display": "standalone",
      "orientation": "portrait"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      "expo-font",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Use Face ID to unlock Project Serenity."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Only used if you choose to send your location to an emergency contact."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#0D1626"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-web-browser",
      [
        "expo-audio",
        {
          "microphonePermission": "Only used when you choose to record a voice note for your journal."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#4E649D"
        }
      ]
    ],
    "scheme": "serenity",
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "fc761cf5-33e1-438c-89af-b8353adcfc2f"
      }
    }
  }
}

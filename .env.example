# Copy this file to `.env` and paste your Supabase project's values.
# Supabase dashboard > Project Settings > API (or Data API).
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=paste-the-publishable-or-anon-key-here
# NEVER put the service_role / secret key in this file or anywhere in the app.

# Social sign-in buttons that are switched on (set each one up in Supabase first, see SECURITY.md).
# Leave one out to show "coming soon" for that button.
EXPO_PUBLIC_AUTH_PROVIDERS=google,apple,facebook
